# Production Environment Variables for Railway
# Copy these to Railway's Environment Variables section

# Server Configuration
PORT=${{RAILWAY_PORT}}
NODE_ENV=production

# Database Configuration (Railway PostgreSQL)
# Railway will provide this automatically when you add PostgreSQL service
DATABASE_URL=${{DATABASE_URL}}

# JWT Configuration
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your_production_jwt_secret_change_this
JWT_EXPIRES_IN=7d

# CORS Configuration
# Update this with your Vercel frontend URL after deployment
FRONTEND_URL=https://your-app.vercel.app

# File Upload Configuration
MAX_FILE_SIZE=33554432
UPLOAD_DIR=uploads/
